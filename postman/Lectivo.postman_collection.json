            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/constraints/", "host": ["{{baseUrl}}"], "path": ["api", "constraints", ""] },
            "description": "Lista todas las restricciones de horario del colegio."
          }
        },
        {
          "name": "Restricciones de un profesor",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/constraints/teacher/{{teacherId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "constraints", "teacher", "{{teacherId}}"]
            },
            "description": "Lista las restricciones de horario de un profesor concreto."
          }
        },
        {
          "name": "Crear restricción [Admin]",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/constraints/", "host": ["{{baseUrl}}"], "path": ["api", "constraints", ""] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"constraintType\": \"unavailable\",\n  \"dayOfWeek\": 5,\n  \"slotIndex\": 4,\n  \"weight\": 100,\n  \"reason\": \"Coordinación de ciclo\"\n}"
            },
            "description": "Crea una restricción de horario para un profesor. constraintType: 'unavailable' | 'preferred' | 'avoid'. dayOfWeek: 1=lunes…5=viernes. slotIndex: índice de franja (0-based). weight: 1-100. Requiere rol Admin."
          }
        },
        {
          "name": "Eliminar restricción [Admin]",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/constraints/{{constraintId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "constraints", "{{constraintId}}"]
            },
            "description": "Elimina una restricción de horario. Requiere rol Admin."
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Listar horarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedules/?stageId={{stageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedules", ""],
              "query": [{ "key": "stageId", "value": "{{stageId}}", "description": "Filtrar por etapa (opcional)" }]
            },
            "description": "Lista los horarios generados. Los profesores solo ven los publicados."
          }
        },
        {
          "name": "Generar horario [Admin]",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/schedules/generate", "host": ["{{baseUrl}}"], "path": ["api", "schedules", "generate"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stageId\": \"{{stageId}}\",\n  \"periodId\": \"{{periodId}}\",\n  \"academicYear\": \"2025-2026\",\n  \"timeoutSeconds\": 60\n}"
            },
            "description": "Encola un job de generación de horario. Devuelve 202 con { jobId }. Monitoriza el progreso vía SignalR en /hubs/generation o consulta el estado con GET /api/schedules/jobs/{jobId}. Requiere rol Admin."
          }
        },
        {
          "name": "Estado del job de generación",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedules/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedules", "jobs", "{{jobId}}"]
            },
            "description": "Consulta el estado de un job Hangfire de generación de horario."
          }
        },
        {
          "name": "Mi horario (profesor)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schedules/me", "host": ["{{baseUrl}}"], "path": ["api", "schedules", "me"] },
            "description": "Devuelve el horario publicado del profesor autenticado."
          }
        },
        {
          "name": "Obtener horario",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedules", "{{scheduleId}}"]
            },
            "description": "Devuelve los detalles de un horario. Los profesores solo pueden ver horarios publicados."
          }
        },
        {
          "name": "Publicar horario [Admin]",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/schedules/{{scheduleId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedules", "{{scheduleId}}", "publish"]
            },
            "description": "Publica un horario, haciéndolo visible para los profesores. Requiere rol Admin."
          }
        },
        {
          "name": "Actualizar entrada de horario [Admin]",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/schedules/{{scheduleId}}/entries/{{entryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedules", "{{scheduleId}}", "entries", "{{entryId}}"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"classroomId\": \"{{classroomId}}\"\n}"
            },
            "description": "Modifica manualmente una entrada del horario (reasignar profesor o aula). Requiere rol Admin."
          }
        },
        {
          "name": "Eliminar horario [Admin]",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedules", "{{scheduleId}}"]
            },
            "description": "Elimina un horario generado. Requiere rol Admin."
          }
        }
      ]
    },
    {
      "name": "Dev",
      "description": "Endpoints solo disponibles fuera de Production. Útiles para restablecer el estado de la base de datos a los datos demo.",
      "item": [
        {
          "name": "Re-seed base de datos",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/dev/reseed", "host": ["{{baseUrl}}"], "path": ["api", "dev", "reseed"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"levels\": 6,\n  \"linesPerLevel\": 2,\n  \"modality\": \"bilingue\",\n  \"scheduleType\": \"partida\"\n}"
            },
            "description": "Borra y regenera todos los datos demo. Todos los campos son opcionales; los omitidos toman el valor de la configuración Seed. modality: 'estandar' | 'bilingue'. scheduleType: 'continua' | 'partida'. Solo disponible fuera de Production."
          }
        }
      ]
    },
    {
      "name": "Infraestructura",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Estado de salud de la API (y Redis si está configurado)."
          }
        }
      ]
    }
  ]
}
