{
  "info": {
    "_postman_id": "lectivo-collection-2026",
    "name": "Lectivo API",
    "description": "Colección completa de la API de Lectivo — generador de horarios escolares LOMLOE.\n\n**Autenticación:** Configura la variable `apiKey` en el entorno con el valor de `ApiKey:Key` (appsettings.Local.json). El header `X-Api-Key` se incluye automáticamente en todas las peticiones.\n\n**Alternativa:** Usa `X-User-Email` con el email de uno de los usuarios demo en lugar de la API key.\n\n**Hub SignalR:** El hub de progreso de generación de horarios está en `ws://{{baseUrl}}/hubs/generation` (no es una petición REST; conéctate con un cliente SignalR).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Devuelve el perfil del usuario autenticado (mediante X-Api-Key o X-User-Email). 401 si no hay usuario identificado."
          }
        },
        {
          "name": "Usuarios demo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/demo-users", "host": ["{{baseUrl}}"], "path": ["api", "auth", "demo-users"] },
            "description": "Lista todos los usuarios demo disponibles con sus emails y roles."
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/roles/", "host": ["{{baseUrl}}"], "path": ["api", "roles", ""] },
            "description": "Catálogo global de roles (director, jefe_estudios, secretario, profesor, tutor, coordinador_ciclo, orientador)."
          }
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "Datos del colegio",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schools/me", "host": ["{{baseUrl}}"], "path": ["api", "schools", "me"] },
