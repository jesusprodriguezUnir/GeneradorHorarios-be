        {
          "name": "Actualizar colegio [Admin]",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/api/schools/me", "host": ["{{baseUrl}}"], "path": ["api", "schools", "me"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CEIP Miguel Hernández\",\n  \"centerCode\": \"28012345\",\n  \"locality\": \"Madrid\",\n  \"community\": \"Madrid\",\n  \"academicYear\": \"2025-2026\",\n  \"scheduleType\": \"partida\",\n  \"morningStart\": \"09:00\",\n  \"slotMinutes\": 60,\n  \"breakAfterSlot\": 2,\n  \"breakMinutes\": 30,\n  \"slotsPerDay\": 5,\n  \"afternoonSlots\": 0,\n  \"afternoonStart\": null,\n  \"workingDays\": [1, 2, 3, 4, 5]\n}"
            },
            "description": "Actualiza los datos del colegio. Requiere rol Admin."
          }
        },
        {
          "name": "Horario de ciclo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schools/me/cycles/{{cycle}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schools", "me", "cycles", "{{cycle}}"]
